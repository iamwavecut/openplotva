[Unit]
Description=OpenPlotva incident maintenance controller
After=network-online.target docker.service openplotva-omp-gateway.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/etc/openplotva-maintenance/config.json

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/opt/openplotva-maintenance
ExecStart=/usr/bin/python3 /opt/openplotva-maintenance/controller.py --config /etc/openplotva-maintenance/config.json serve
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=mixed
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The loop mount must be visible to the host Docker daemon. Filesystem namespace
# sandboxing belongs to the job container; enabling PrivateMounts/ProtectSystem
# here would silently bind an empty directory instead of the bounded filesystem.
PrivateMounts=false
NoNewPrivileges=true
MemoryMax=512M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
