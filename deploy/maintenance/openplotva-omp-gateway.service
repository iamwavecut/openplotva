[Unit]
Description=OMP auth gateway for OpenPlotva maintenance
After=network-online.target openplotva-omp-broker.service
Requires=openplotva-omp-broker.service

[Service]
Type=simple
User=openplotva-omp
Group=openplotva-omp
UMask=0077
Environment=PI_CONFIG_DIR=.omp
Environment=OMP_AUTH_BROKER_URL=http://127.0.0.1:8765
ExecStart=/opt/openplotva-maintenance/omp auth-gateway serve --bind=127.0.0.1:4000
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openplotva-omp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
