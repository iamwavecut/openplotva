# Install as /etc/cron.d/openplotva-uploader-retention, owned by root, mode 0644.
# geta.moe uses UTC. Media URLs in old messages expire when their files are deleted.
# Preserve the existing -mtime +7 policy: delete at eight complete days of age.
# Do not follow symlinks or cross filesystems. A lock and deadline bound each run.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

30 4 * * * root /usr/bin/flock -n /run/lock/openplotva-uploader-retention.lock /usr/bin/timeout 5m /usr/bin/nice -n 19 /usr/bin/ionice -c 3 /usr/bin/find /var/lib/docker/volumes/plotva-uploader_uploader-data/_data -xdev -type f -mtime +7 -delete
